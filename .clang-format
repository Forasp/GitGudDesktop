# Gitgud Desktop C++ style — derived from src/main.cpp formatting pass (2026-07).
BasedOnStyle: LLVM
Standard: c++17

IndentWidth: 4
ColumnLimit: 100
NamespaceIndentation: All

# Allman braces everywhere; else/catch go on the line after the closing brace.
BreakBeforeBraces: Allman

# Braces are mandatory, even for single-statement if/for/while bodies.
InsertBraces: true
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: Inline

# Blank-line policy: one max; always a blank line between definitions.
MaxEmptyLinesToKeep: 1
SeparateDefinitionBlocks: Always
KeepEmptyLinesAtTheStartOfBlocks: false

PointerAlignment: Left
IndentPPDirectives: None
# Never sort: Windows headers (windows.h before wincred.h) and the SDL scancode
# table are include-order-sensitive.
SortIncludes: Never
IncludeBlocks: Preserve
AlignAfterOpenBracket: DontAlign
ContinuationIndentWidth: 4
BinPackArguments: true
BinPackParameters: true
