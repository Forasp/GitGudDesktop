<?xml version="1.0" encoding="UTF-8"?>
<!--
  files.xml - the Files tab: the selected folder's contents as a table
  (scripts/depot/views/files.lua builds the grid inside FilesGridHost).
-->
<GUILayout version="4">
    <Window type="DefaultWindow" name="FilesPanel">
        <Property name="Area" value="{{0,1},{0,1},{1,-1},{1,-1}}"/>
        <Property name="Visible" value="false"/>

        <Window type="Gitgud/StaticText" name="FilesHeader">
            <Property name="Area" value="{{0,0},{0,0},{1,0},{0,26}}"/>
            <Property name="PanelColour" value="FF25484F"/>
            <Property name="Text" value=""/>
            <Window type="Gitgud/Label" name="FilesTitle">
                <Property name="Area" value="{{0,8},{0,0},{1,-200},{1,0}}"/>
                <Property name="Text" value=""/>
            </Window>
            <Window type="Gitgud/Checkbox" name="FilesShowUntracked">
                <Property name="Area" value="{{1,-196},{0,3},{1,-6},{1,-3}}"/>
                <Property name="Text" value="Show untracked files"/>
            </Window>
        </Window>
        <Window type="DefaultWindow" name="FilesGridHost">
            <Property name="Area" value="{{0,0},{0,26},{1,0},{1,0}}"/>
        </Window>
    </Window>
</GUILayout>
