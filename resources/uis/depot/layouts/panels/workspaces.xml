<?xml version="1.0" encoding="UTF-8"?>
<!--
  workspaces.xml - the Workspaces tab: this repository's working trees
  (git worktrees) plus the other repositories you've opened; switch to one
  with a double-click. scripts/depot/views/workspaces.lua.
-->
<GUILayout version="4">
    <Window type="DefaultWindow" name="WorkspacesPanel">
        <Property name="Area" value="{{0,1},{0,1},{1,-1},{1,-1}}"/>
        <Property name="Visible" value="false"/>

        <Window type="Gitgud/StaticText" name="WorkspacesHeader">
            <Property name="Area" value="{{0,0},{0,0},{1,0},{0,30}}"/>
            <Property name="PanelColour" value="FF25484F"/>
            <Property name="Text" value=""/>
            <Window type="Gitgud/Label" name="WorkspacesHint">
                <Property name="Area" value="{{0,8},{0,0},{1,-440},{1,0}}"/>
                <Property name="Text" value="Double-click a workspace to switch to it."/>
            </Window>
            <Window type="Gitgud/Button" name="WorkspacesCloneButton">
                <Property name="Area" value="{{1,-432},{0,4},{1,-296},{1,-4}}"/>
                <Property name="Text" value="Clone…"/>
            </Window>
            <Window type="Gitgud/Button" name="WorkspacesAddButton">
                <Property name="Area" value="{{1,-290},{0,4},{1,-150},{1,-4}}"/>
                <Property name="Text" value="Open Existing…"/>
            </Window>
            <Window type="Gitgud/Button" name="WorkspacesNewButton">
                <Property name="Area" value="{{1,-144},{0,4},{1,-8},{1,-4}}"/>
                <Property name="Text" value="New Worktree…"/>
            </Window>
        </Window>
        <Window type="DefaultWindow" name="WorkspacesGridHost">
            <Property name="Area" value="{{0,0},{0,30},{1,0},{1,0}}"/>
        </Window>
    </Window>
</GUILayout>
