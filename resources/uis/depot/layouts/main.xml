<?xml version="1.0" encoding="UTF-8"?>
<!--
  main.xml - the Depot UI's window, top to bottom:

    MenuBar       File Edit Search View Actions Connection Tools Window Help
                  (built in Lua: scripts/depot/menus.lua over the shared ui/menu)
    Toolbar       icon-over-label buttons (scripts/depot/toolbar.lua)
    AddressBar    the selected depot path; type a path and press Enter
    WorkArea      left: Depot / Workspace tree   right: tabbed views
                  bottom: Log / Dashboard. Splitters between them are
                  draggable (scripts/depot/frame.lua positions everything).
    StatusBar     the selected item's path, messages on the right

  The window uses the OS frame (gitgud.setWindowBordered).
  Panels live in panels/*.xml; the shared dialog, popup blocker, command
  palette, and modal shade are Dagobah-coloured copies (dialogs/, popups/) or
  imported from the default UI (resourceGroup="gitgud-layouts").
-->
<GUILayout version="4">
    <Window type="DefaultWindow" name="Root">
        <Property name="Area" value="{{0,0},{0,0},{1,0},{1,0}}"/>

        <Window type="Gitgud/StaticText" name="AppBackground">
            <Property name="Area" value="{{0,0},{0,0},{1,0},{1,0}}"/>
            <Property name="PanelColour" value="FF28333C"/>
            <Property name="CursorPassThroughEnabled" value="true"/>
            <Property name="Text" value=""/>
        </Window>

        <!-- Menu bar: ui/menu.lua fills MenuBar with MenuBar_<id> buttons. -->
        <Window type="Gitgud/StaticText" name="MenuStrip">
            <Property name="Area" value="{{0,0},{0,0},{1,0},{0,22}}"/>
            <Property name="PanelColour" value="FF1F2731"/>
            <Property name="Text" value=""/>
            <Window type="DefaultWindow" name="MenuBar">
                <Property name="Area" value="{{0,2},{0,0},{1,0},{1,0}}"/>
            </Window>
        </Window>

        <LayoutImport filename="frame/toolbar.xml"/>
        <LayoutImport filename="frame/addressbar.xml"/>

        <Window type="DefaultWindow" name="WorkArea">
            <Property name="Area" value="{{0,0},{0,100},{1,0},{1,-22}}"/>
            <LayoutImport filename="frame/leftpane.xml"/>
            <LayoutImport filename="frame/rightpane.xml"/>
            <LayoutImport filename="frame/bottompane.xml"/>

            <!-- Splitters (draggable; 5px grips between the panes). -->
            <Window type="Gitgud/Button" name="SplitLeft">
                <Property name="Area" value="{{0.25,0},{0,0},{0.25,5},{0.8,0}}"/>
                <Property name="Text" value=""/>
                <Property name="NormalFillColour" value="FF28333C"/>
                <Property name="HoverFillColour" value="FF276460"/>
                <Property name="PushedFillColour" value="FF34796A"/>
                <Property name="BorderColour" value="00000000"/>
                <Property name="TooltipText" value="Drag to resize"/>
            </Window>
            <Window type="Gitgud/Button" name="SplitBottom">
                <Property name="Area" value="{{0,0},{0.8,0},{1,0},{0.8,5}}"/>
                <Property name="Text" value=""/>
                <Property name="NormalFillColour" value="FF28333C"/>
                <Property name="HoverFillColour" value="FF276460"/>
                <Property name="PushedFillColour" value="FF34796A"/>
                <Property name="BorderColour" value="00000000"/>
                <Property name="TooltipText" value="Drag to resize"/>
            </Window>
        </Window>

        <LayoutImport filename="frame/statusbar.xml"/>

        <LayoutImport filename="popups/blocker.xml" resourceGroup="gitgud-layouts"/>
        <LayoutImport filename="popups/palette.xml"/>
        <LayoutImport filename="dialogs/shade.xml" resourceGroup="gitgud-layouts"/>
        <LayoutImport filename="dialogs/dialog.xml"/>
        <LayoutImport filename="dialogs/changelist.xml"/>
    </Window>
</GUILayout>
