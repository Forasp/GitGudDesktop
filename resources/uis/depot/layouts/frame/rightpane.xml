<?xml version="1.0" encoding="UTF-8"?>
<!--
  rightpane.xml - the tabbed views. RightTabs holds the tab buttons
  (scripts/depot/tabs.lua); each view is a panel in RightBody, one visible at a
  time: Files, History, Pending, Submitted, Branches, Labels, Workspaces.
-->
<GUILayout version="4">
    <Window type="DefaultWindow" name="RightPane">
        <Property name="Area" value="{{0.25,5},{0,0},{1,0},{0.8,0}}"/>

        <Window type="DefaultWindow" name="RightTabs">
            <Property name="Area" value="{{0,0},{0,2},{1,-4},{0,26}}"/>
        </Window>
        <Window type="Gitgud/StaticText" name="RightBody">
            <Property name="Area" value="{{0,0},{0,26},{1,-4},{1,0}}"/>
            <Property name="PanelColour" value="FF1F2731"/>
            <Property name="FrameEnabled" value="true"/>
            <Property name="FrameColour" value="FF525445"/>
            <Property name="Text" value=""/>

            <LayoutImport filename="panels/files.xml"/>
            <LayoutImport filename="panels/history.xml"/>
            <LayoutImport filename="panels/pending.xml"/>
            <LayoutImport filename="panels/submitted.xml"/>
            <LayoutImport filename="panels/branches.xml"/>
            <LayoutImport filename="panels/labels.xml"/>
            <LayoutImport filename="panels/workspaces.xml"/>
        </Window>
    </Window>
</GUILayout>
