<?xml version="1.0" encoding="UTF-8"?>
<!--
  history.xml (Bragi UI) - the History tab in design D, replacing the GitGud
  UI's file of that name. It keeps every widget the GitGud UI's
  views/history.lua drives, restyled: the filter, the branch comparison,
  and the commit list, whose rows (a graph line with a dot per commit, the
  summary and its branch and tag labels, then author, age and SHA) are drawn
  by scripts/bragi/repolook.lua.

  views/history.lua moves HistoryList (inside BragiHistoryListFrame, so it
  keeps a 10px margin) to the tops set in scripts/bragi/repolook.lua
  (history.setLook): keep them in step.
-->
<GUILayout version="4">
    <Window type="DefaultWindow" name="HistoryPanel">
        <Property name="Area" value="{{0,0},{0,0},{1,0},{1,0}}"/>
        <Property name="Visible" value="false"/>

        <Window type="Bragi/Box8" name="BragiHistoryFilterBox">
            <Property name="Area" value="{{0,20},{0,16},{1,-20},{0,56}}"/>
            <Property name="FillColour" value="$well"/>
            <Property name="BorderColour" value="$border"/>
            <Window type="Gitgud/Editbox" name="HistoryFilterEdit">
                <Property name="Area" value="{{0,8},{0,2},{1,-36},{1,-2}}"/>
                <Property name="BgColour" value="00000000"/>
                <Property name="BorderColour" value="00000000"/>
                <Property name="Font" value="Bragi-13"/>
                <Property name="Text" value=""/>
            </Window>
            <Window type="Gitgud/Label" name="HistoryFilterPlaceholder">
                <Property name="Area" value="{{0,12},{0,0},{1,-40},{1,0}}"/>
                <Property name="Text" value="Filter by message, author or SHA"/>
                <Property name="Font" value="Bragi-13"/>
                <Property name="NormalTextColour" value="$sub"/>
                <Property name="CursorPassThroughEnabled" value="true"/>
            </Window>
            <Window type="Gitgud/Icon" name="HistoryFilterIcon">
                <Property name="Area" value="{{1,-30},{0.5,-9},{1,-12},{0.5,9}}"/>
                <Property name="IconImage" value="Gitgud-Images/IconSearch"/>
                <Property name="IconColour" value="$sub"/>
                <Property name="GlowColour" value="00000000"/>
                <Property name="CursorPassThroughEnabled" value="true"/>
            </Window>
        </Window>

        <Window type="Bragi/Button8" name="CompareButton">
            <Property name="Area" value="{{0,20},{0,64},{1,-20},{0,96}}"/>
            <Property name="Text" value="Compare with a branch…"/>
            <Property name="Font" value="Bragi-13"/>
            <Property name="HorzFormatting" value="LeftAligned"/>
            <Property name="NormalFillColour" value="00000000"/>
            <Property name="BorderColour" value="$border"/>
            <Property name="NormalTextColour" value="$sub"/>
            <Property name="HoverTextColour" value="$text"/>
        </Window>

        <!-- Shown while comparing: the two directions. -->
        <Window type="Bragi/Box10" name="CompareBar">
            <Property name="Area" value="{{0,20},{0,102},{1,-20},{0,136}}"/>
            <Property name="FillColour" value="$rail"/>
            <Property name="Visible" value="false"/>
            <Window type="Bragi/Button8" name="CompareBehindTab">
                <Property name="Area" value="{{0,3},{0,3},{0.5,-1},{1,-3}}"/>
                <Property name="Text" value="Behind"/>
                <Property name="Font" value="Bragi-12-Bold"/>
                <Property name="BorderColour" value="00000000"/>
            </Window>
            <Window type="Bragi/Button8" name="CompareAheadTab">
                <Property name="Area" value="{{0.5,1},{0,3},{1,-3},{1,-3}}"/>
                <Property name="Text" value="Ahead"/>
                <Property name="Font" value="Bragi-12-Bold"/>
                <Property name="BorderColour" value="00000000"/>
            </Window>
        </Window>

        <Window type="Gitgud/StaticText" name="HistoryHairline">
            <Property name="Area" value="{{0,0},{0,103},{1,0},{0,104}}"/>
            <Property name="PanelColour" value="00000000"/>
            <Property name="CursorPassThroughEnabled" value="true"/>
            <Property name="Text" value=""/>
        </Window>

        <Window type="DefaultWindow" name="BragiHistoryListFrame">
            <Property name="Area" value="{{0,10},{0,0},{1,-10},{1,0}}"/>
            <Property name="CursorPassThroughEnabled" value="true"/>
            <Window type="Gitgud/ListWidget" name="HistoryList">
                <Property name="Area" value="{{0,0},{0,104},{1,0},{1,-44}}"/>
                <Property name="HorzScrollbarDisplayMode" value="Hidden"/>
                <Property name="BgColour" value="00000000"/>
                <Property name="BorderColour" value="00000000"/>
                <Property name="SelectionColour" value="$sel"/>
                <Property name="SelectionBrushImage" value="Bragi-Rows/Row61x300"/>
            </Window>
        </Window>

        <Window type="Bragi/Button8" name="CompareMergeButton">
            <Property name="Area" value="{{0,20},{1,-42},{1,-20},{1,-8}}"/>
            <Property name="Text" value="Merge into current branch"/>
            <Property name="Font" value="Bragi-13-Bold"/>
            <Property name="NormalFillColour" value="$accent"/>
            <Property name="HoverFillColour" value="$accent-hover"/>
            <Property name="PushedFillColour" value="$accent-pressed"/>
            <Property name="BorderColour" value="00000000"/>
            <Property name="NormalTextColour" value="$on-accent"/>
            <Property name="HoverTextColour" value="$on-accent"/>
            <Property name="PushedTextColour" value="$on-accent"/>
            <Property name="Visible" value="false"/>
        </Window>
        <Window type="Bragi/Button8" name="HistoryMoreButton">
            <Property name="Area" value="{{0,20},{1,-42},{1,-20},{1,-8}}"/>
            <Property name="Text" value="Load more commits"/>
            <Property name="Font" value="Bragi-13-Bold"/>
            <Property name="NormalFillColour" value="00000000"/>
            <Property name="BorderColour" value="$border"/>
            <Property name="Visible" value="false"/>
        </Window>
    </Window>
</GUILayout>
