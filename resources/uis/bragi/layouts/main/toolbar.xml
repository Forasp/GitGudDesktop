            </Window>
        </Window>

        <!-- ================= Changes | History ================= -->
        <Window type="Bragi/Box10" name="BragiRepoTabs">
            <Property name="Area" value="{{1,-604},{0,10},{1,-400},{0,48}}"/>
            <Property name="FillColour" value="$rail"/>
            <Window type="Bragi/Button8" name="BragiChangesTab">
                <Property name="Area" value="{{0,3},{0,3},{0,117},{1,-3}}"/>
                <Property name="Text" value=""/>
                <Property name="BorderColour" value="00000000"/>
                <Property name="TooltipText" value="Uncommitted changes"/>
                <Window type="Gitgud/Label" name="BragiChangesTabLabel">
                    <Property name="Area" value="{{0,14},{0,0},{1,-38},{1,0}}"/>
                    <Property name="Text" value="Changes"/>
                    <Property name="Font" value="Bragi-13-Bold"/>
                    <Property name="NormalTextColour" value="$text"/>
