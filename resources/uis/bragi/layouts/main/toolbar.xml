            </Window>
        </Window>
        <Window type="Bragi/Button8" name="UndoButton">
            <Property name="Area" value="{{0,556},{0,12},{0,588},{0,44}}"/>
            <Property name="Text" value=""/>
            <Property name="NormalFillColour" value="00000000"/>
            <Property name="DisabledFillColour" value="00000000"/>
            <Property name="BorderColour" value="00000000"/>
            <Property name="TooltipText" value="Undo  (Ctrl+Z)"/>
            <Window type="Gitgud/Icon" name="UndoButtonIcon">
                <Property name="Area" value="{{0.5,-9},{0.5,-9},{0.5,9},{0.5,9}}"/>
                <Property name="IconImage" value="Gitgud-Images/IconUndo"/>
