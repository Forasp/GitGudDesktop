                <Property name="IconColour" value="$sub"/>
                <Property name="GlowColour" value="00000000"/>
                <Property name="CursorPassThroughEnabled" value="true"/>
            </Window>
            <Window type="Gitgud/Label" name="GraphButtonLabel">
                <Property name="Area" value="{{0,0},{0,0},{0,0},{0,0}}"/>
                <Property name="Visible" value="false"/>
            </Window>
        </Window>
        <Window type="Bragi/Button8" name="ConsoleButton">
            <Property name="Area" value="{{0,664},{0,12},{0,696},{0,44}}"/>
            <Property name="Text" value=""/>
            <Property name="NormalFillColour" value="00000000"/>
            <Property name="DisabledFillColour" value="00000000"/>
            <Property name="BorderColour" value="00000000"/>
            <Property name="TooltipText" value="Console  (Ctrl+`)"/>
            <Window type="Gitgud/Icon" name="ConsoleButtonIcon">
                <Property name="Area" value="{{0.5,-9},{0.5,-9},{0.5,9},{0.5,9}}"/>
                <Property name="IconImage" value="Gitgud-Images/IconTerminal"/>
                <Property name="IconColour" value="$sub"/>
                <Property name="GlowColour" value="00000000"/>
                <Property name="CursorPassThroughEnabled" value="true"/>
            </Window>
            <Window type="Gitgud/Label" name="ConsoleButtonLabel">
