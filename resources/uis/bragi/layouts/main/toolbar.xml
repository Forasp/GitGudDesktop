                </Window>
                <Window type="Bragi/Box8" name="BragiChangesCount">
                    <Property name="Area" value="{{1,-34},{0.5,-9},{1,-10},{0.5,9}}"/>
                    <Property name="FillColour" value="$accent"/>
                    <Property name="CursorPassThroughEnabled" value="true"/>
                    <Window type="Gitgud/Label" name="BragiChangesCountLabel">
                        <Property name="Area" value="{{0,0},{0,0},{1,0},{1,0}}"/>
                        <Property name="Text" value=""/>
                        <Property name="Font" value="Bragi-12-Bold"/>
                        <Property name="HorzFormatting" value="CentreAligned"/>
                        <Property name="NormalTextColour" value="$on-accent"/>
                        <Property name="CursorPassThroughEnabled" value="true"/>
                    </Window>
                </Window>
            </Window>
            <Window type="Bragi/Button8" name="BragiHistoryTab">
                <Property name="Area" value="{{0,119},{0,3},{1,-3},{1,-3}}"/>
                <Property name="Text" value="History"/>
                <Property name="Font" value="Bragi-13-Bold"/>
                <Property name="BorderColour" value="00000000"/>
                <Property name="TooltipText" value="Commit history"/>
            </Window>
        </Window>

        <!-- ================= search (the command palette) ================= -->
        <Window type="Bragi/Button8" name="PaletteButton">
            <Property name="Area" value="{{1,-388},{0,10},{1,-148},{0,46}}"/>
            <Property name="Text" value=""/>
            <Property name="NormalFillColour" value="$well"/>
            <Property name="HoverFillColour" value="$well"/>
            <Property name="PushedFillColour" value="$well"/>
            <Property name="BorderColour" value="$border"/>
            <Property name="TooltipText" value="Search, or run any command  (Ctrl+K)"/>
            <Window type="Gitgud/Icon" name="PaletteButtonIcon">
                <Property name="Area" value="{{0,0},{0,0},{0,0},{0,0}}"/>
                <Property name="IconImage" value="Gitgud-Images/IconCommand"/>
                <Property name="Visible" value="false"/>
            </Window>
            <Window type="Gitgud/Label" name="PaletteButtonLabel">
                <Property name="Area" value="{{0,12},{0,0},{1,-60},{1,0}}"/>
                <Property name="Text" value="Search or run a command"/>
                <Property name="Font" value="Bragi-13"/>
                <Property name="NormalTextColour" value="$sub"/>
                <Property name="CursorPassThroughEnabled" value="true"/>
            </Window>
            <Window type="Gitgud/Label" name="PaletteButtonKey">
                <Property name="Area" value="{{1,-60},{0,0},{1,-12},{1,0}}"/>
                <Property name="Text" value="Ctrl K"/>
                <Property name="Font" value="Bragi-Mono-11"/>
                <Property name="HorzFormatting" value="RightAligned"/>
                <Property name="NormalTextColour" value="$sub"/>
                <Property name="CursorPassThroughEnabled" value="true"/>
            </Window>
        </Window>

        <Window type="Gitgud/StaticText" name="ToolbarHairline">
            <Property name="Area" value="{{0,0},{1,-1},{1,0},{1,0}}"/>
            <Property name="PanelColour" value="$border"/>
            <Property name="CursorPassThroughEnabled" value="true"/>
            <Property name="Text" value=""/>
        </Window>
    </Window>
</GUILayout>
