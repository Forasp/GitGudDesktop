<?xml version="1.0" encoding="UTF-8"?>
<!--
  toolbar.xml (Bragi UI) - the Repository view's 56px top bar (design D),
  replacing the GitGud UI's toolbar. It sits at y=32 inside RepoView, which
  starts 32px above the window, so it's the window's top edge.

    repo ▾  main ▾  Fetch origin   [branches undo redo graph console]
    [Changes n | History]  [Search or run a command  Ctrl K]  (window buttons)

  It keeps every widget the GitGud UI's views/toolbar.lua and friends drive
  (RepoButton/RepoValue, BranchButton/BranchValue, SyncButton and its icon
  and labels, Undo/Redo/Graph/Console/Palette buttons with Icon and Label
  children); labels the design doesn't show are hidden. scripts/bragi/repo.lua
  lays the left group out to fit and drives the Changes / History switch.
-->
<GUILayout version="4">
    <Window type="Gitgud/StaticText" name="Toolbar">
        <Property name="Area" value="{{0,0},{0,32},{1,0},{0,88}}"/>
        <Property name="PanelColour" value="$bg"/>
        <Property name="Text" value=""/>
        <UserString name="AppDrag" value="true"/>

        <!-- ================= repository and branch ================= -->
        <Window type="Bragi/Button8" name="RepoButton">
            <Property name="Area" value="{{0,24},{0,10},{0,164},{0,46}}"/>
            <Property name="Text" value=""/>
            <Property name="BorderColour" value="$border"/>
            <Property name="TooltipText" value="Switch, add, clone, or create a repository  (Ctrl+T)"/>
            <Window type="Gitgud/Icon" name="RepoIcon">
                <Property name="Area" value="{{0,0},{0,0},{0,0},{0,0}}"/>
                <Property name="IconImage" value="Gitgud-Images/IconRepo"/>
                <Property name="Visible" value="false"/>
            </Window>
            <Window type="Gitgud/Label" name="RepoLabel">
                <Property name="Area" value="{{0,0},{0,0},{0,0},{0,0}}"/>
                <Property name="Visible" value="false"/>
            </Window>
            <Window type="Gitgud/Label" name="RepoValue">
                <Property name="Area" value="{{0,12},{0,0},{1,-28},{1,0}}"/>
                <Property name="Text" value=""/>
                <Property name="Font" value="Bragi-Mono-13"/>
                <Property name="NormalTextColour" value="$text"/>
                <Property name="CursorPassThroughEnabled" value="true"/>
            </Window>
            <Window type="Gitgud/Icon" name="RepoChevron">
                <Property name="Area" value="{{1,-21},{0.5,-5},{1,-11},{0.5,5}}"/>
                <Property name="IconImage" value="Gitgud-Images/Chevron"/>
                <Property name="IconColour" value="$sub"/>
                <Property name="GlowColour" value="00000000"/>
                <Property name="CursorPassThroughEnabled" value="true"/>
            </Window>
        </Window>

        <Window type="Bragi/Button8" name="BranchButton">
            <Property name="Area" value="{{0,174},{0,10},{0,314},{0,46}}"/>
            <Property name="Text" value=""/>
            <Property name="BorderColour" value="$border"/>
            <Property name="TooltipText" value="Switch, create, or merge branches  (Ctrl+B)"/>
            <Window type="Gitgud/Icon" name="BranchIcon">
                <Property name="Area" value="{{0,0},{0,0},{0,0},{0,0}}"/>
                <Property name="IconImage" value="Gitgud-Images/IconBranch"/>
                <Property name="Visible" value="false"/>
            </Window>
            <Window type="Gitgud/Label" name="BranchLabel">
                <Property name="Area" value="{{0,0},{0,0},{0,0},{0,0}}"/>
                <Property name="Visible" value="false"/>
            </Window>
            <Window type="Gitgud/Label" name="BranchValue">
                <Property name="Area" value="{{0,12},{0,0},{1,-28},{1,0}}"/>
                <Property name="Text" value=""/>
                <Property name="Font" value="Bragi-Mono-13"/>
                <Property name="NormalTextColour" value="$text"/>
                <Property name="CursorPassThroughEnabled" value="true"/>
            </Window>
            <Window type="Gitgud/Icon" name="BranchChevron">
                <Property name="Area" value="{{1,-21},{0.5,-5},{1,-11},{0.5,5}}"/>
                <Property name="IconImage" value="Gitgud-Images/Chevron"/>
                <Property name="IconColour" value="$sub"/>
                <Property name="GlowColour" value="00000000"/>
                <Property name="CursorPassThroughEnabled" value="true"/>
            </Window>
        </Window>

        <!-- Fetch / push / pull: a quiet text button. -->
        <Window type="Bragi/Button8" name="SyncButton">
            <Property name="Area" value="{{0,322},{0,10},{0,512},{0,46}}"/>
            <Property name="Text" value=""/>
            <Property name="NormalFillColour" value="00000000"/>
            <Property name="DisabledFillColour" value="00000000"/>
            <Property name="BorderColour" value="00000000"/>
