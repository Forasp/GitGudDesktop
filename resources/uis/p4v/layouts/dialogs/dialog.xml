<?xml version="1.0" encoding="UTF-8"?>
<!--
  P4V UI copy of resources/layouts/dialogs/dialog.xml in the Dagobah colours (same widget
  names: the shared Lua drives it unchanged).

  dialog.xml - ONE general-purpose modal dialog, reused for every prompt in
  the app (confirmations, new branch, clone, sign-in, options, ...).

  It declares a title, a message, five labelled text fields (each with an
  optional Browse… button), three checkboxes, an error line, and three
  buttons. scripts/ui/dialog.lua shows only what a given prompt asks for and
  stacks the visible rows top to bottom, so these Areas are just defaults:

      dialog.prompt({ title = "New branch", fields = { { label = "Name" } },
                      ok = "Create branch", onOk = function(values) ... end })
-->
<GUILayout version="4">
    <Window type="Gitgud/StaticText" name="Dialog">
        <Property name="Area" value="{{0.5,-250},{0.5,-160},{0.5,250},{0.5,160}}"/>
        <Property name="PanelColour" value="FF28333C"/>
        <Property name="FrameEnabled" value="true"/>
        <Property name="AlwaysOnTop" value="true"/>
        <Property name="Visible" value="false"/>
        <Property name="Text" value=""/>

        <Window type="Gitgud/Label" name="DialogTitle">
            <Property name="Area" value="{{0,22},{0,16},{1,-22},{0,44}}"/>
            <Property name="Font" value="Gitgud-UI-Title"/>
            <Property name="Text" value=""/>
