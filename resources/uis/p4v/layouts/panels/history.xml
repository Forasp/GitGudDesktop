<?xml version="1.0" encoding="UTF-8"?>
<!--
  history.xml - the History tab: every revision of the selected file or
  folder (top), and the selected revision's Details / Files (bottom), split
  by a draggable bar. scripts/p4/views/history.lua.
-->
<GUILayout version="4">
    <Window type="DefaultWindow" name="HistoryPanel">
        <Property name="Area" value="{{0,1},{0,1},{1,-1},{1,-1}}"/>
        <Property name="Visible" value="false"/>

        <Window type="Gitgud/StaticText" name="HistoryHeader">
            <Property name="Area" value="{{0,0},{0,0},{1,0},{0,26}}"/>
            <Property name="PanelColour" value="FF25484F"/>
            <Property name="Text" value=""/>
            <Window type="Gitgud/Label" name="HistoryTitle">
                <Property name="Area" value="{{0,8},{0,0},{1,-8},{1,0}}"/>
                <Property name="Text" value="Select a file or folder in the tree."/>
            </Window>
        </Window>
        <Window type="DefaultWindow" name="HistoryGridHost">
            <Property name="Area" value="{{0,0},{0,26},{1,0},{0.55,0}}"/>
        </Window>
        <Window type="Gitgud/Button" name="HistorySplit">
            <Property name="Area" value="{{0,0},{0.55,0},{1,0},{0.55,5}}"/>
            <Property name="Text" value=""/>
            <Property name="NormalFillColour" value="FF28333C"/>
            <Property name="HoverFillColour" value="FF276460"/>
            <Property name="PushedFillColour" value="FF34796A"/>
            <Property name="BorderColour" value="00000000"/>
        </Window>
        <Window type="DefaultWindow" name="HistoryDetailHost">
            <Property name="Area" value="{{0,0},{0.55,5},{1,0},{1,0}}"/>
            <Window type="DefaultWindow" name="HistoryDetailTabs">
                <Property name="Area" value="{{0,4},{0,0},{1,-4},{0,24}}"/>
            </Window>
            <Window type="Gitgud/MultiLineEditbox" name="HistoryDetailText">
                <Property name="Area" value="{{0,4},{0,24},{1,-4},{1,-4}}"/>
                <Property name="ReadOnly" value="true"/>
                <Property name="Text" value=""/>
            </Window>
            <Window type="DefaultWindow" name="HistoryFilesHost">
                <Property name="Area" value="{{0,4},{0,24},{1,-4},{1,-4}}"/>
                <Property name="Visible" value="false"/>
            </Window>
        </Window>
    </Window>
</GUILayout>
