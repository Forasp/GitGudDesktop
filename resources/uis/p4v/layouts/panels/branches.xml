<?xml version="1.0" encoding="UTF-8"?>
<!--
  branches.xml - the Branches tab (P4V's branch mappings / streams, here
  git branches): local and remote branches with their tips, owners, and
  sync state. scripts/p4/views/branches.lua.
-->
<GUILayout version="4">
    <Window type="DefaultWindow" name="BranchesPanel">
        <Property name="Area" value="{{0,1},{0,1},{1,-1},{1,-1}}"/>
        <Property name="Visible" value="false"/>

        <Window type="Gitgud/StaticText" name="BranchesHeader">
            <Property name="Area" value="{{0,0},{0,0},{1,0},{0,30}}"/>
            <Property name="PanelColour" value="FF25484F"/>
            <Property name="Text" value=""/>
            <Window type="Gitgud/Label" name="BranchesFilterLabel">
                <Property name="Area" value="{{0,8},{0,0},{0,50},{1,0}}"/>
                <Property name="Text" value="Filter:"/>
            </Window>
            <Window type="Gitgud/Editbox" name="BranchesFilterEdit">
                <Property name="Area" value="{{0,52},{0,4},{0.4,0},{1,-4}}"/>
                <Property name="Text" value=""/>
            </Window>
            <Window type="Gitgud/Checkbox" name="BranchesShowRemote">
                <Property name="Area" value="{{0.4,10},{0,3},{0.4,200},{1,-3}}"/>
                <Property name="Text" value="Show remote branches"/>
                <Property name="Selected" value="true"/>
            </Window>
            <Window type="Gitgud/Button" name="BranchesNewButton">
                <Property name="Area" value="{{1,-140},{0,4},{1,-8},{1,-4}}"/>
                <Property name="Text" value="New Branch…"/>
            </Window>
        </Window>
        <Window type="DefaultWindow" name="BranchesGridHost">
            <Property name="Area" value="{{0,0},{0,30},{1,0},{1,0}}"/>
        </Window>
    </Window>
</GUILayout>
