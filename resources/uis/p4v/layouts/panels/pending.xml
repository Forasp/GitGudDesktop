<?xml version="1.0" encoding="UTF-8"?>
<!--
  pending.xml - the Pending tab: your pending changelists (the default one
  plus numbered ones you create), each with its opened files and shelved
  files, as a tree. Changelists are local to this machine; shelving one
  makes a branch you can share. scripts/p4/views/pending.lua.
-->
<GUILayout version="4">
    <Window type="DefaultWindow" name="PendingPanel">
        <Property name="Area" value="{{0,1},{0,1},{1,-1},{1,-1}}"/>
        <Property name="Visible" value="false"/>

        <Window type="Gitgud/StaticText" name="PendingHeader">
            <Property name="Area" value="{{0,0},{0,0},{1,0},{0,30}}"/>
            <Property name="PanelColour" value="FF25484F"/>
            <Property name="Text" value=""/>
            <Window type="Gitgud/Label" name="PendingUserLabel">
                <Property name="Area" value="{{0,8},{0,0},{0,110},{1,0}}"/>
                <Property name="Text" value="Show changelists:"/>
            </Window>
            <Window type="Gitgud/Button" name="PendingScopeButton">
                <Property name="Area" value="{{0,112},{0,4},{0,332},{1,-4}}"/>
                <Property name="Text" value="Mine"/>
                <Property name="HorzFormatting" value="LeftAligned"/>
                <Property name="TooltipText" value="Your changelists, or everyone's shelved changelists too"/>
            </Window>
            <Window type="Gitgud/Button" name="PendingNewButton">
                <Property name="Area" value="{{1,-160},{0,4},{1,-8},{1,-4}}"/>
                <Property name="Text" value="New Changelist…"/>
            </Window>
        </Window>
        <Window type="Gitgud/ListWidget" name="PendingTree">
            <Property name="Area" value="{{0,0},{0,30},{1,0},{0.72,0}}"/>
            <Property name="BorderColour" value="FF1F2731"/>
            <Property name="MultiSelect" value="true"/>
        </Window>
        <Window type="Gitgud/Button" name="PendingSplit">
            <Property name="Area" value="{{0,0},{0.72,0},{1,0},{0.72,5}}"/>
            <Property name="Text" value=""/>
            <Property name="NormalFillColour" value="FF28333C"/>
            <Property name="HoverFillColour" value="FF276460"/>
            <Property name="PushedFillColour" value="FF34796A"/>
            <Property name="BorderColour" value="00000000"/>
        </Window>
        <Window type="Gitgud/MultiLineEditbox" name="PendingDetailText">
            <Property name="Area" value="{{0,4},{0.72,5},{1,-4},{1,-4}}"/>
            <Property name="ReadOnly" value="true"/>
            <Property name="Text" value=""/>
        </Window>
    </Window>
</GUILayout>
