<?xml version="1.0" encoding="UTF-8"?>
<!--
  graph.xml - the commit graph (View > Commit graph, Ctrl+3, or the Graph
  button on the toolbar). It takes the sidebar's place and the top of the
  content pane; the selected commit's details show below it.

  Three lists scrolled in step form the columns: GraphList (the lane
  picture, branch/tag labels, and the summary), GraphAuthorList, and
  GraphDateList. scripts/views/graph.lua fills them; the lane pictures are
  drawn by the engine (gitgud.graph) and shown inline as images.
-->
<GUILayout version="4">
    <Window type="Gitgud/StaticText" name="GraphPanel">
        <Property name="Area" value="{{0,236},{0,0},{1,0},{0.56,0}}"/>
        <Property name="PanelColour" value="FF17102B"/>
        <Property name="Visible" value="false"/>
        <Property name="Text" value=""/>

        <Window type="Gitgud/Label" name="GraphTitle">
            <Property name="Area" value="{{0,16},{0,0},{0,250},{0,40}}"/>
            <Property name="Font" value="Gitgud-UI-Bold"/>
            <Property name="Text" value="Commit graph"/>
        </Window>
        <Window type="Gitgud/Editbox" name="GraphFilterEdit">
            <Property name="Area" value="{{0,250},{0,6},{0.55,0},{0,34}}"/>
            <Property name="Text" value=""/>
        </Window>
        <Window type="Gitgud/Label" name="GraphFilterPlaceholder">
            <Property name="Area" value="{{0,260},{0,6},{0.55,-30},{0,34}}"/>
            <Property name="Text" value="Find a commit (message, author, SHA)"/>
            <Property name="NormalTextColour" value="FF766A9C"/>
        </Window>
        <Window type="Gitgud/Checkbox" name="GraphRemotesCheck">
            <Property name="Area" value="{{0.55,8},{0,5},{0.55,160},{0,35}}"/>
            <Property name="Text" value="Remote branches"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
        </Window>
        <Window type="Gitgud/Checkbox" name="GraphTagsCheck">
            <Property name="Area" value="{{0.55,160},{0,5},{0.55,240},{0,35}}"/>
            <Property name="Text" value="Tags"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
        </Window>
        <Window type="Gitgud/Button" name="GraphCloseButton">
            <Property name="Area" value="{{1,-120},{0,7},{1,-12},{0,33}}"/>
            <Property name="Text" value="Close graph"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="NormalFillColour" value="FF1F1738"/>
            <Property name="HoverFillColour" value="FF291F47"/>
            <Property name="BorderColour" value="2EC4B5FD"/>
            <Property name="TooltipText" value="Back to Changes / History  (Ctrl+3)"/>
        </Window>

        <Window type="Gitgud/StaticText" name="GraphColumnHeader">
            <Property name="Area" value="{{0,0},{0,40},{1,0},{0,64}}"/>
            <Property name="PanelColour" value="FF1A1331"/>
            <Property name="Text" value=""/>
            <Window type="Gitgud/Label" name="GraphHeaderGraph">
                <Property name="Area" value="{{0,12},{0,0},{1,-370},{1,0}}"/>
                <Property name="Font" value="Gitgud-UI-Small"/>
                <Property name="Text" value="GRAPH  ·  DESCRIPTION"/>
                <Property name="NormalTextColour" value="FF766A9C"/>
            </Window>
            <Window type="Gitgud/Label" name="GraphHeaderAuthor">
                <Property name="Area" value="{{1,-360},{0,0},{1,-210},{1,0}}"/>
                <Property name="Font" value="Gitgud-UI-Small"/>
                <Property name="Text" value="AUTHOR"/>
                <Property name="NormalTextColour" value="FF766A9C"/>
            </Window>
            <Window type="Gitgud/Label" name="GraphHeaderDate">
                <Property name="Area" value="{{1,-200},{0,0},{1,-10},{1,0}}"/>
                <Property name="Font" value="Gitgud-UI-Small"/>
                <Property name="Text" value="DATE  ·  SHA"/>
                <Property name="NormalTextColour" value="FF766A9C"/>
            </Window>
        </Window>

        <Window type="Gitgud/ListWidget" name="GraphList">
            <Property name="Area" value="{{0,0},{0,64},{1,-360},{1,-36}}"/>
            <Property name="HorzScrollbarDisplayMode" value="Hidden"/>
            <Property name="VertScrollbarDisplayMode" value="Hidden"/>
            <Property name="BgColour" value="FF17102B"/>
            <Property name="BorderColour" value="FF17102B"/>
            <Property name="SelectionColour" value="FF291F47"/>
        </Window>
        <Window type="Gitgud/ListWidget" name="GraphAuthorList">
            <Property name="Area" value="{{1,-360},{0,64},{1,-200},{1,-36}}"/>
            <Property name="HorzScrollbarDisplayMode" value="Hidden"/>
            <Property name="VertScrollbarDisplayMode" value="Hidden"/>
            <Property name="BgColour" value="FF17102B"/>
            <Property name="BorderColour" value="FF17102B"/>
            <Property name="SelectionColour" value="FF291F47"/>
        </Window>
        <Window type="Gitgud/ListWidget" name="GraphDateList">
            <Property name="Area" value="{{1,-200},{0,64},{1,0},{1,-36}}"/>
            <Property name="HorzScrollbarDisplayMode" value="Hidden"/>
            <Property name="BgColour" value="FF17102B"/>
            <Property name="BorderColour" value="FF17102B"/>
            <Property name="SelectionColour" value="FF291F47"/>
        </Window>

        <Window type="Gitgud/Label" name="GraphFooterLabel">
            <Property name="Area" value="{{0,16},{1,-34},{1,-200},{1,-2}}"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="Text" value=""/>
            <Property name="NormalTextColour" value="FF766A9C"/>
        </Window>
        <Window type="Gitgud/Button" name="GraphMoreButton">
            <Property name="Area" value="{{1,-190},{1,-32},{1,-12},{1,-6}}"/>
            <Property name="Text" value="Load more commits"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="NormalFillColour" value="FF1F1738"/>
            <Property name="HoverFillColour" value="FF291F47"/>
            <Property name="BorderColour" value="2EC4B5FD"/>
        </Window>
        <Window type="Gitgud/StaticText" name="GraphBottomHairline">
            <Property name="Area" value="{{0,0},{1,-1},{1,0},{1,0}}"/>
            <Property name="PanelColour" value="2EC4B5FD"/>
            <Property name="CursorPassThroughEnabled" value="true"/>
            <Property name="Text" value=""/>
        </Window>
    </Window>
</GUILayout>
