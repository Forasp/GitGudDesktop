<?xml version="1.0" encoding="UTF-8"?>
<!--
  toolbar.xml - the three full-height toolbar controls, GitHub Desktop
  style: current repository | current branch | fetch / push / pull, then a
  group of quick actions: undo / redo, the commit graph, the console, and
  the command palette.

  Each control is a borderless button with an icon, a small-caps label, a
  bold value, and (for the two dropdowns) a chevron. The layout owns the
  labels; scripts/views/toolbar.lua fills the *Value labels and swaps the
  sync icon between fetch / push / pull.
-->
<GUILayout version="4">
    <Window type="Gitgud/StaticText" name="Toolbar">
        <Property name="Area" value="{{0,0},{0,32},{1,0},{0,88}}"/>
        <Property name="PanelColour" value="FF17102B"/>
        <Property name="Text" value=""/>

        <!-- ================= current repository ================= -->
        <Window type="Gitgud/Button" name="RepoButton">
            <Property name="Area" value="{{0,0},{0,0},{0,288},{1,-1}}"/>
            <Property name="Text" value=""/>
            <Property name="NormalFillColour" value="FF17102B"/>
            <Property name="HoverFillColour" value="FF291F47"/>
            <Property name="PushedFillColour" value="FF0E0A1A"/>
            <Property name="TooltipText" value="Switch, add, clone, or create a repository  (Ctrl+T)"/>
            <Window type="Gitgud/Icon" name="RepoIcon">
                <Property name="Area" value="{{0,14},{0.5,-10},{0,34},{0.5,10}}"/>
                <Property name="IconImage" value="Gitgud-Images/IconRepo"/>
            </Window>
            <Window type="Gitgud/Label" name="RepoLabel">
                <Property name="Area" value="{{0,46},{0,9},{1,-30},{0,24}}"/>
                <Property name="Text" value="CURRENT REPOSITORY"/>
                <Property name="Font" value="Gitgud-UI-Small"/>
                <Property name="NormalTextColour" value="FF766A9C"/>
            </Window>
            <Window type="Gitgud/Label" name="RepoValue">
                <Property name="Area" value="{{0,46},{0,24},{1,-30},{1,-8}}"/>
                <Property name="Text" value=""/>
                <Property name="Font" value="Gitgud-UI-Bold"/>
            </Window>
            <Window type="Gitgud/Icon" name="RepoChevron">
                <Property name="Area" value="{{1,-26},{0.5,-4},{1,-14},{0.5,4}}"/>
                <Property name="IconImage" value="Gitgud-Images/Chevron"/>
                <Property name="IconColour" value="FF766A9C"/>
                <Property name="GlowColour" value="00000000"/>
                <Property name="CursorPassThroughEnabled" value="true"/>
            </Window>
        </Window>
        <Window type="Gitgud/StaticText" name="ToolbarDivider1">
            <Property name="Area" value="{{0,288},{0,0},{0,289},{1,-1}}"/>
            <Property name="PanelColour" value="2EC4B5FD"/>
            <Property name="CursorPassThroughEnabled" value="true"/>
