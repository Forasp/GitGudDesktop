<?xml version="1.0" encoding="UTF-8"?>
<!--
  rebase.xml - the interactive rebase editor (right-click a commit in the
  graph or History > "Interactive rebase from here…", or Branch >
  Interactive rebase…). One row per commit, newest at the top; choose what
  happens to each (pick, reword, squash, fixup, drop) and drag rows (or use
  the arrows / Alt+Up/Down) to reorder. Nothing changes until "Rewrite".
  scripts/views/rebase.lua drives it.
-->
<GUILayout version="4">
    <Window type="Gitgud/StaticText" name="RebaseDialog">
        <Property name="Area" value="{{0.5,-380},{0.5,-300},{0.5,380},{0.5,300}}"/>
        <Property name="PanelColour" value="FF1F1738"/>
        <Property name="FrameEnabled" value="true"/>
        <Property name="AlwaysOnTop" value="true"/>
        <Property name="Visible" value="false"/>
        <Property name="Text" value=""/>

        <Window type="Gitgud/Label" name="RebaseTitle">
            <Property name="Area" value="{{0,22},{0,14},{1,-22},{0,42}}"/>
            <Property name="Font" value="Gitgud-UI-Title"/>
            <Property name="Text" value="Interactive rebase"/>
        </Window>
        <Window type="Gitgud/Label" name="RebaseHint">
            <Property name="Area" value="{{0,22},{0,42},{1,-22},{0,64}}"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="Text" value="Newest at the top. Pick an action for each commit; drag rows or use the arrows to reorder."/>
            <Property name="NormalTextColour" value="FFB7AED6"/>
        </Window>

        <Window type="Gitgud/ListWidget" name="RebaseList">
            <Property name="Area" value="{{0,22},{0,70},{1,-22},{1,-238}}"/>
            <Property name="HorzScrollbarDisplayMode" value="Hidden"/>
            <Property name="BgColour" value="FF17102B"/>
            <Property name="BorderColour" value="2EC4B5FD"/>
            <Property name="SelectionColour" value="FF342A56"/>
        </Window>

        <Window type="Gitgud/Button" name="RebasePickButton">
            <Property name="Area" value="{{0,22},{1,-230},{0,112},{1,-202}}"/>
            <Property name="Text" value="Pick"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="TooltipText" value="Keep the commit as it is"/>
        </Window>
        <Window type="Gitgud/Button" name="RebaseRewordButton">
            <Property name="Area" value="{{0,116},{1,-230},{0,206},{1,-202}}"/>
            <Property name="Text" value="Reword"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="TooltipText" value="Keep the changes, edit the message below"/>
        </Window>
        <Window type="Gitgud/Button" name="RebaseSquashButton">
            <Property name="Area" value="{{0,210},{1,-230},{0,300},{1,-202}}"/>
            <Property name="Text" value="Squash"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="TooltipText" value="Fold into the commit below it, joining the messages"/>
        </Window>
        <Window type="Gitgud/Button" name="RebaseFixupButton">
            <Property name="Area" value="{{0,304},{1,-230},{0,394},{1,-202}}"/>
            <Property name="Text" value="Fixup"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="TooltipText" value="Fold into the commit below it, dropping this message"/>
        </Window>
        <Window type="Gitgud/Button" name="RebaseDropButton">
            <Property name="Area" value="{{0,398},{1,-230},{0,488},{1,-202}}"/>
            <Property name="Text" value="Drop"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="TooltipText" value="Leave the commit out"/>
        </Window>
        <Window type="Gitgud/Button" name="RebaseUpButton">
            <Property name="Area" value="{{1,-104},{1,-230},{1,-64},{1,-202}}"/>
            <Property name="Text" value="↑"/>
            <Property name="TooltipText" value="Move up (newer)  (Alt+Up)"/>
        </Window>
        <Window type="Gitgud/Button" name="RebaseDownButton">
            <Property name="Area" value="{{1,-60},{1,-230},{1,-22},{1,-202}}"/>
            <Property name="Text" value="↓"/>
            <Property name="TooltipText" value="Move down (older)  (Alt+Down)"/>
        </Window>

        <Window type="Gitgud/Label" name="RebaseMessageLabel">
            <Property name="Area" value="{{0,22},{1,-194},{1,-22},{1,-174}}"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="Text" value="Message"/>
            <Property name="NormalTextColour" value="FFB7AED6"/>
        </Window>
        <Window type="Gitgud/MultiLineEditbox" name="RebaseMessageEdit">
            <Property name="Area" value="{{0,22},{1,-172},{1,-22},{1,-76}}"/>
            <Property name="Text" value=""/>
        </Window>

        <Window type="Gitgud/Label" name="RebaseError">
            <Property name="Area" value="{{0,22},{1,-72},{1,-280},{1,-50}}"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="Text" value=""/>
            <Property name="NormalTextColour" value="FFFF5457"/>
        </Window>
        <Window type="Gitgud/StaticText" name="RebaseButtonHairline">
            <Property name="Area" value="{{0,0},{1,-61},{1,0},{1,-60}}"/>
            <Property name="PanelColour" value="1FC4B5FD"/>
            <Property name="CursorPassThroughEnabled" value="true"/>
            <Property name="Text" value=""/>
        </Window>
        <Window type="Gitgud/Label" name="RebaseSummaryLabel">
            <Property name="Area" value="{{0,22},{1,-48},{1,-290},{1,-14}}"/>
            <Property name="Font" value="Gitgud-UI-Small"/>
            <Property name="Text" value=""/>
            <Property name="NormalTextColour" value="FF766A9C"/>
        </Window>
        <Window type="Gitgud/Button" name="RebaseCancelButton">
            <Property name="Area" value="{{1,-282},{1,-46},{1,-166},{1,-14}}"/>
            <Property name="Text" value="Cancel"/>
        </Window>
        <Window type="Gitgud/Button" name="RebaseStartButton">
            <Property name="Area" value="{{1,-158},{1,-46},{1,-22},{1,-14}}"/>
            <Property name="Text" value="Rewrite history"/>
            <Property name="NormalFillColour" value="FF7C93FF"/>
            <Property name="HoverFillColour" value="FF93A4FF"/>
            <Property name="PushedFillColour" value="FF6F84E6"/>
            <Property name="NormalTextColour" value="FF0E0A1A"/>
            <Property name="HoverTextColour" value="FF0E0A1A"/>
            <Property name="PushedTextColour" value="FF0E0A1A"/>
            <Property name="BorderColour" value="FF93A4FF"/>
            <Property name="Font" value="Gitgud-UI-Bold"/>
        </Window>
    </Window>
</GUILayout>
