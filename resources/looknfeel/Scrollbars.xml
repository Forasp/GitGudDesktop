<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scrollbars.xml - scrollbars and their thumbs.

  Slim overlay-style bars: no arrow buttons (they're kept, zero-sized,
  because CEGUI's scrollbar expects them), a transparent track so the list
  shows through, and a 6px rounded-feel thumb that brightens on hover. The
  thumb is sized proportionally in C++ (CeguiBackend) because Falagard never
  sizes it.

  Part of the Gitgud skin: resources/schemes/Gitgud.xml lists every
  looknfeel file. All colours are widget PROPERTIES, so layouts (or Lua via
  gitgud.setProperty) can restyle a widget without touching this file.
-->
<Falagard version="7">

    <!-- ======================= Scrollbar thumbs ====================== -->
    <WidgetLook name="Gitgud/VerticalScrollbarThumb">
        <Property name="VertFree" value="true"/>
        <Property name="CursorInputPropagationEnabled" value="true"/>
        <Property name="Size" value="{{0, 6}, {0, 32}}" />
        <ImagerySection name="thumb">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                    <Dim type="Width"><UnifiedDim scale="1.0" type="Width"/></Dim>
                    <Dim type="Height"><UnifiedDim scale="1.0" type="Height"/></Dim>
                </Area>
                <Image name="Vanilla-Images/GenericBrush"/>
                <Colours topLeft="B35A4B8A" bottomLeft="B35A4B8A" topRight="B35A4B8A" bottomRight="B35A4B8A"/>
                <VertFormat type="Stretched"/>
                <HorzFormat type="Stretched"/>
            </ImageryComponent>
        </ImagerySection>
        <ImagerySection name="thumbActive">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                    <Dim type="Width"><UnifiedDim scale="1.0" type="Width"/></Dim>
                    <Dim type="Height"><UnifiedDim scale="1.0" type="Height"/></Dim>
                </Area>
                <Image name="Vanilla-Images/GenericBrush"/>
                <Colours topLeft="FF8A7BC4" bottomLeft="FF8A7BC4" topRight="FF8A7BC4" bottomRight="FF8A7BC4"/>
                <VertFormat type="Stretched"/>
                <HorzFormat type="Stretched"/>
            </ImageryComponent>
        </ImagerySection>
        <StateImagery name="Normal"><Layer><Section section="thumb"/></Layer></StateImagery>
        <StateImagery name="Hover"><Layer><Section section="thumbActive"/></Layer></StateImagery>
        <StateImagery name="Pushed"><Layer><Section section="thumbActive"/></Layer></StateImagery>
    </WidgetLook>
    <WidgetLook name="Gitgud/HorizontalScrollbarThumb">
        <Property name="HorzFree" value="true"/>
        <Property name="CursorInputPropagationEnabled" value="true"/>
        <Property name="Size" value="{{0, 32}, {0, 6}}" />
        <ImagerySection name="thumb">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                    <Dim type="Width"><UnifiedDim scale="1.0" type="Width"/></Dim>
                    <Dim type="Height"><UnifiedDim scale="1.0" type="Height"/></Dim>
                </Area>
                <Image name="Vanilla-Images/GenericBrush"/>
                <Colours topLeft="B35A4B8A" bottomLeft="B35A4B8A" topRight="B35A4B8A" bottomRight="B35A4B8A"/>
                <VertFormat type="Stretched"/>
                <HorzFormat type="Stretched"/>
            </ImageryComponent>
        </ImagerySection>
        <ImagerySection name="thumbActive">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                    <Dim type="Width"><UnifiedDim scale="1.0" type="Width"/></Dim>
                    <Dim type="Height"><UnifiedDim scale="1.0" type="Height"/></Dim>
                </Area>
                <Image name="Vanilla-Images/GenericBrush"/>
                <Colours topLeft="FF8A7BC4" bottomLeft="FF8A7BC4" topRight="FF8A7BC4" bottomRight="FF8A7BC4"/>
                <VertFormat type="Stretched"/>
                <HorzFormat type="Stretched"/>
            </ImageryComponent>
        </ImagerySection>
        <StateImagery name="Normal"><Layer><Section section="thumb"/></Layer></StateImagery>
        <StateImagery name="Hover"><Layer><Section section="thumbActive"/></Layer></StateImagery>
        <StateImagery name="Pushed"><Layer><Section section="thumbActive"/></Layer></StateImagery>
    </WidgetLook>

    <!-- ========================== Scrollbars ========================= -->
    <WidgetLook name="Gitgud/HorizontalScrollbar">
        <Property name="Size" value="{{1, 0}, {0, 12}}" />
        <NamedArea name="ThumbTrackArea">
            <Area>
                <Dim type="LeftEdge"><WidgetDim widget="__auto_decbtn__" dimension="RightEdge"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="RightEdge">
                    <OperatorDim op="Subtract">
                        <UnifiedDim scale="1" type="RightEdge"/>
                        <WidgetDim widget="__auto_incbtn__" dimension="Width"/>
                    </OperatorDim>
                </Dim>
                <Dim type="BottomEdge"><UnifiedDim scale="1" type="BottomEdge"/></Dim>
            </Area>
        </NamedArea>
        <Child nameSuffix="__auto_incbtn__" type="Gitgud/Button">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="Width"><AbsoluteDim value="0"/></Dim>
                <Dim type="Height"><AbsoluteDim value="0"/></Dim>
            </Area>
            <VertAlignment type="CentreAligned"/>
            <HorzAlignment type="RightAligned"/>
            <Property name="UseStandardImagery" value="false"/>
            <Property name="Visible" value="false"/>
        </Child>
        <Child nameSuffix="__auto_decbtn__" type="Gitgud/Button">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="Width"><AbsoluteDim value="0"/></Dim>
                <Dim type="Height"><AbsoluteDim value="0"/></Dim>
            </Area>
            <VertAlignment type="CentreAligned"/>
            <Property name="UseStandardImagery" value="false"/>
            <Property name="Visible" value="false"/>
        </Child>
        <Child nameSuffix="__auto_thumb__" type="Gitgud/HorizontalScrollbarThumb">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="3"/></Dim>
                <Dim type="Width"><AbsoluteDim value="32"/></Dim>
                <Dim type="Height"><AbsoluteDim value="6"/></Dim>
            </Area>
        </Child>
        <ImagerySection name="main">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><WidgetDim widget="__auto_decbtn__" dimension="RightEdge"/></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                    <Dim type="RightEdge">
                        <OperatorDim op="Subtract">
                            <UnifiedDim scale="1" type="RightEdge"/>
                            <WidgetDim widget="__auto_incbtn__" dimension="Width"/>
                        </OperatorDim>
                    </Dim>
                    <Dim type="BottomEdge"><UnifiedDim scale="1" type="BottomEdge"/></Dim>
                </Area>
                <Image name="Vanilla-Images/GenericBrush"/>
                <Colours topLeft="00000000" bottomLeft="00000000" topRight="00000000" bottomRight="00000000"/>
                <VertFormat type="Stretched"/>
                <HorzFormat type="Stretched"/>
            </ImageryComponent>
        </ImagerySection>
        <StateImagery name="Enabled"><Layer><Section section="main"/></Layer></StateImagery>
        <StateImagery name="Disabled"><Layer><Section section="main"/></Layer></StateImagery>
    </WidgetLook>
    <WidgetLook name="Gitgud/VerticalScrollbar">
        <Property name="VerticalScrollbar" value="true"/>
        <Property name="Size" value="{{0, 12}, {1, 0}}" />
        <NamedArea name="ThumbTrackArea">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><WidgetDim widget="__auto_decbtn__" dimension="BottomEdge"/></Dim>
                <Dim type="RightEdge"><UnifiedDim scale="1.0" type="RightEdge"/></Dim>
                <Dim type="BottomEdge">
                    <OperatorDim op="Subtract">
                        <UnifiedDim scale="1.0" type="BottomEdge"/>
                        <WidgetDim widget="__auto_incbtn__" dimension="Height"/>
                    </OperatorDim>
                </Dim>
            </Area>
        </NamedArea>
        <Child nameSuffix="__auto_incbtn__" type="Gitgud/Button">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="Width"><AbsoluteDim value="0"/></Dim>
                <Dim type="Height"><AbsoluteDim value="0"/></Dim>
            </Area>
            <VertAlignment type="BottomAligned"/>
            <HorzAlignment type="CentreAligned"/>
            <Property name="UseStandardImagery" value="false"/>
            <Property name="Visible" value="false"/>
        </Child>
        <Child nameSuffix="__auto_decbtn__" type="Gitgud/Button">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="Width"><AbsoluteDim value="0"/></Dim>
                <Dim type="Height"><AbsoluteDim value="0"/></Dim>
            </Area>
            <HorzAlignment type="CentreAligned"/>
            <Property name="UseStandardImagery" value="false"/>
            <Property name="Visible" value="false"/>
        </Child>
        <Child nameSuffix="__auto_thumb__" type="Gitgud/VerticalScrollbarThumb">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="3"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="Width"><AbsoluteDim value="6"/></Dim>
                <Dim type="Height"><AbsoluteDim value="32"/></Dim>
            </Area>
        </Child>
        <ImagerySection name="main">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                    <Dim type="TopEdge"><WidgetDim widget="__auto_decbtn__" dimension="BottomEdge"/></Dim>
                    <Dim type="RightEdge"><UnifiedDim scale="1.0" type="RightEdge"/></Dim>
                    <Dim type="BottomEdge">
                        <OperatorDim op="Subtract">
                            <UnifiedDim scale="1.0" type="BottomEdge"/>
                            <WidgetDim widget="__auto_incbtn__" dimension="Height"/>
                        </OperatorDim>
                    </Dim>
                </Area>
                <Image name="Vanilla-Images/GenericBrush"/>
                <Colours topLeft="00000000" bottomLeft="00000000" topRight="00000000" bottomRight="00000000"/>
                <VertFormat type="Stretched"/>
                <HorzFormat type="Stretched"/>
            </ImageryComponent>
        </ImagerySection>
        <StateImagery name="Enabled"><Layer><Section section="main"/></Layer></StateImagery>
        <StateImagery name="Disabled"><Layer><Section section="main"/></Layer></StateImagery>
    </WidgetLook>

</Falagard>
