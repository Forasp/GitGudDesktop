<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lists.xml - list views and scrollable panes.

  Gitgud/ListView (every list: diffs, history, branches) and
  Gitgud/ScrollablePane (the runtime-built Changes rows).

  Part of the Gitgud skin: resources/schemes/Gitgud.xml lists every
  looknfeel file. All colours are widget PROPERTIES, so layouts (or Lua via
  gitgud.setProperty) can restyle a widget without touching this file.
-->
<Falagard version="7">

    <!-- ========================== ListView =========================== -->
    <WidgetLook name="Gitgud/ListView">
        <PropertyDefinition redrawOnWrite="true" initialValue="FF17102B" type="ColourRect" name="BgColour"/>
        <PropertyDefinition redrawOnWrite="true" initialValue="2EC4B5FD" type="ColourRect" name="BorderColour"/>
        <Property name="VertScrollbarDisplayMode" value="WhenNeeded"/>
        <Property name="HorzScrollbarDisplayMode" value="WhenNeeded"/>
        <Property name="SelectionBrushImage" value="Vanilla-Images/GenericBrush"/>
        <Property name="SelectionColour" value="FF342A56"/>
        <Property name="Size" value="{{1, 0}, {1, 0}}" />
        <NamedArea name="ItemRenderingArea">
            <Area>
                <Dim type="LeftEdge"><ImageDim name="Vanilla-Images/FrameLeft" dimension="Width"/></Dim>
                <Dim type="TopEdge"><ImageDim name="Vanilla-Images/FrameTop" dimension="Height"/></Dim>
                <Dim type="RightEdge">
                    <OperatorDim op="Subtract">
                        <UnifiedDim scale="1" type="RightEdge"/>
                        <ImageDim name="Vanilla-Images/FrameRight" dimension="Width"/>
                    </OperatorDim>
                </Dim>
                <Dim type="BottomEdge">
                    <OperatorDim op="Subtract">
                        <UnifiedDim scale="1" type="BottomEdge"/>
                        <ImageDim name="Vanilla-Images/FrameBottom" dimension="Height"/>
                    </OperatorDim>
                </Dim>
            </Area>
        </NamedArea>
        <Child nameSuffix="__auto_hscrollbar__" type="Gitgud/HorizontalScrollbar">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="3"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="-3"/></Dim>
                <Dim type="Width"><UnifiedDim scale="1" type="Width" offset="-20"/></Dim>
                <Dim type="Height"><AbsoluteDim value="14"/></Dim>
            </Area>
            <VertAlignment type="BottomAligned"/>
        </Child>
        <Child nameSuffix="__auto_vscrollbar__" type="Gitgud/VerticalScrollbar">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="-3"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="3"/></Dim>
                <Dim type="Width"><AbsoluteDim value="14"/></Dim>
                <Dim type="Height"><UnifiedDim scale="1" type="Height" offset="-6"/></Dim>
            </Area>
            <HorzAlignment type="RightAligned"/>
        </Child>
        <StateImagery name="Enabled">
            <Layer>
                <Section section="BackgroundOnlyFull" look="Gitgud/Shared">
                    <ColourProperty name="BgColour"/>
                </Section>
            </Layer>
        </StateImagery>
        <StateImagery name="Disabled">
            <Layer>
                <Section section="BackgroundOnlyFull" look="Gitgud/Shared">
                    <ColourProperty name="BgColour"/>
                </Section>
            </Layer>
        </StateImagery>
    </WidgetLook>

    <!-- ======================= ScrollablePane ========================
         Free-form scrolling container for Lua-built composite rows (the
         Changes file list). Transparent: whatever panel sits behind shows
         through; scrollbars are the shared Gitgud ones. -->
    <WidgetLook name="Gitgud/ScrollablePane">
        <Property name="Size" value="{{1, 0}, {1, 0}}" />
        <NamedArea name="ViewableArea">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="RightEdge"><UnifiedDim scale="1" type="RightEdge"/></Dim>
                <Dim type="BottomEdge"><UnifiedDim scale="1" type="BottomEdge"/></Dim>
            </Area>
        </NamedArea>
        <NamedArea name="ViewableAreaHScroll">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="RightEdge"><UnifiedDim scale="1" type="RightEdge"/></Dim>
                <Dim type="BottomEdge"><UnifiedDim scale="1" type="BottomEdge" offset="-14"/></Dim>
            </Area>
        </NamedArea>
        <NamedArea name="ViewableAreaVScroll">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="RightEdge"><UnifiedDim scale="1" type="RightEdge" offset="-14"/></Dim>
                <Dim type="BottomEdge"><UnifiedDim scale="1" type="BottomEdge"/></Dim>
            </Area>
        </NamedArea>
        <NamedArea name="ViewableAreaHVScroll">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="RightEdge"><UnifiedDim scale="1" type="RightEdge" offset="-14"/></Dim>
                <Dim type="BottomEdge"><UnifiedDim scale="1" type="BottomEdge" offset="-14"/></Dim>
            </Area>
        </NamedArea>
        <Child nameSuffix="__auto_hscrollbar__" type="Gitgud/HorizontalScrollbar">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="Width"><UnifiedDim scale="1" type="Width" offset="-14"/></Dim>
                <Dim type="Height"><AbsoluteDim value="14"/></Dim>
            </Area>
            <VertAlignment type="BottomAligned"/>
        </Child>
        <Child nameSuffix="__auto_vscrollbar__" type="Gitgud/VerticalScrollbar">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0"/></Dim>
                <Dim type="Width"><AbsoluteDim value="14"/></Dim>
                <Dim type="Height"><UnifiedDim scale="1" type="Height" offset="-14"/></Dim>
            </Area>
            <HorzAlignment type="RightAligned"/>
        </Child>
        <StateImagery name="Enabled"/>
        <StateImagery name="Disabled"/>
    </WidgetLook>

</Falagard>
