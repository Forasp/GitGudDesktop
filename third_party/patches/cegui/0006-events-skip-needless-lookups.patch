 	void GlobalEventSet::fireEvent(const String& name, EventArgs& args, const String& eventNamespace)
 	{
+        // Gitgud patch: every event any window fires comes through here, and
+        // building "Namespace/Name" to look it up costs an allocation and a
+        // UTF-32 hash per event, while the global set usually holds one or two
+        // subscriptions. Match those in place; keep the lookup for big sets.
+        if (d_muted || d_events.empty())
+            return;
+        if (d_events.size() <= 8)
+        {
+            const size_t nsLength = eventNamespace.length();
+            for (auto& entry : d_events)
+            {
+                const String& key = entry.first;
+                if (key.length() == nsLength + 1 + name.length() &&
+                    key[nsLength] == '/' &&
+                    key.compare(0, nsLength, eventNamespace) == 0 &&
+                    key.compare(nsLength + 1, name.length(), name) == 0)
+                {
+                    (*entry.second)(args);
+                    return;
+                }
+            }
+            return;
+        }
+
         // here we are very explicit about how we construct the event string.
