+//----------------------------------------------------------------------------//
+void EditboxBase::setTextMaskingRevealTime(float seconds)
+{
+    d_textMaskingRevealTime = seconds > 0.f ? seconds : 0.f;
+    if (d_textMaskingRevealTime == 0.f)
+        hideRevealedCharacter();
+}
+
+//----------------------------------------------------------------------------//
+void EditboxBase::hideRevealedCharacter()
+{
+    if (d_revealIndex == String::npos)
+        return;
+
+    d_revealIndex = String::npos;
+    d_renderedTextDirty = true;
+    invalidate();
+}
+
+//----------------------------------------------------------------------------//
+void EditboxBase::updateSelf(float elapsed)
+{
+    Window::updateSelf(elapsed);
+
+    if (d_revealIndex != String::npos)
+    {
+        d_revealTimeLeft -= elapsed;
+        if (d_revealTimeLeft <= 0.f)
+            hideRevealedCharacter();
+    }
+}
