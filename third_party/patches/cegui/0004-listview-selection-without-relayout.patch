+//----------------------------------------------------------------------------//
+void ListView::onSelectionChanged(ItemViewEventArgs& args)
+{
+    // Gitgud patch: a selection change only moves the highlight.
+    // ItemView::onSelectionChanged() calls invalidateView(), which marks the
+    // view dirty, so the next prepareForRender() (a click's own indexAt()
+    // runs one straight away) re-formats the text of EVERY item: O(items)
+    // text layout per click. When the items are otherwise current, refresh
+    // just their selected flags and redraw.
+    if (!d_itemModel || isDirty() ||
+        d_items.size() != d_itemModel->getChildCount(d_itemModel->getRootIndex()))
+    {
+        ItemView::onSelectionChanged(args);
+        return;
+    }
+
+    for (ListViewItemRenderingState& item : d_items)
+        item.d_isSelected = isIndexSelected(item.d_index);
+
+    invalidate(false);
+    fireEvent(EventSelectionChanged, args);
+}
